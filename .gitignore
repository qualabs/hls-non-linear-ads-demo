# The packaged content. It is generated by scripts/preparar-contenido.sh from
# footage that is downloaded, so it does not belong in git: ~55 MB of .ts that
# any clone can rebuild with one command.
content/
node_modules/

# The built library. It is assembled from lib/ by scripts/construir-libreria.sh
# on every start, exactly like the signalled playlist, so a copy in git could
# only be a stale one.
dist/

# El video generado. No va en git por decisión de Nicolás, y la razón es del
# repositorio y no del archivo: subir video es pesado y no aporta. Lo que sí va es
# la receta para volver a generarlo, con los prompts exactos, en
# demo/hydration-break/graphics/creativos/fuentes/README.md. Las imágenes generadas
# sí se quedan: son livianas.
*.mp4

# La investigación: lo que se probó para llegar a lo que está en `demo/`. Generaciones
# descartadas, láminas de contacto, mediciones, capturas del antes y el después, y las
# variantes que no entraron. Es material de trabajo y no del producto: son cientos de
# megabytes, y lo que sí va en git es la conclusión —el script, el prompt, el ADR— no el
# camino. Vive acá y no en `sandbox/` del repo padre porque es de este proyecto: cuando
# alguien pregunte por qué la cadena se siembra así, la evidencia tiene que estar al lado
# del código que la usa.
research/

# El bytecode que CPython escribe al lado de cualquier script que se importe. No es
# del repositorio: se regenera solo y depende de la versión del intérprete que lo
# escribió. Va declarado acá y no como `sys.dont_write_bytecode` adentro de cada
# script, porque una línea que hay que acordarse de poner en el próximo script no es
# un arreglo: ya apareció en dos tasks distintas de la fase 13.
__pycache__/
*.pyc
