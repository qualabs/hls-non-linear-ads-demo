# The packaged content. It is generated by scripts/preparar-contenido.sh from
# footage that is downloaded, so it does not belong in git: ~55 MB of .ts that
# any clone can rebuild with one command.
content/
node_modules/

# The built library. It is assembled from lib/ by scripts/construir-libreria.sh
# on every start, exactly like the signalled playlist, so a copy in git could
# only be a stale one.
dist/
