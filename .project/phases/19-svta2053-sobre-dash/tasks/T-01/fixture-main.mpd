<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="urn:mpeg:dash:schema:mpd:2011"
	xmlns:xlink="http://www.w3.org/1999/xlink"
	xsi:schemaLocation="urn:mpeg:DASH:schema:MPD:2011 http://standards.iso.org/ittf/PubliclyAvailableStandards/MPEG-DASH_schema_files/DASH-MPD.xsd"
	profiles="urn:mpeg:dash:profile:isoff-live:2011"
	type="static"
	mediaPresentationDuration="PT2M30.0S"
	maxSegmentDuration="PT2.0S"
	minBufferTime="PT4.0S">
	<ProgramInformation>
	</ProgramInformation>
	<ServiceDescription id="0">
	</ServiceDescription>
	<Period id="0" start="PT0.0S">
		<EventStream schemeIdUri="urn:svta:advertising-wg:ad-creative-signaling" timescale="1000">
			<Event id="1" presentationTime="0" duration="10000"><![CDATA[{"version":2,"type":"pod","features":{"remoteFields":true,"concurrentPresentation":true},"cue":["PRE"],"payload":[{"duration":12,"$remote":{"slots":"/slots-1.json"}}]}]]></Event>
			<Event id="2" presentationTime="45000" duration="12000"><![CDATA[{"version":2,"type":"pod","features":{"remoteFields":true,"concurrentPresentation":true},"cue":["ONCE"],"payload":[{"duration":12,"$remote":{"slots":"/slots-2.json"}}]}]]></Event>
			<Event id="4" presentationTime="130000" duration="5000">{"version":2,"type":"pod","plain":true}</Event>
			<Event id="3" presentationTime="120000" duration="12000"><![CDATA[{"version":2,"type":"pod","features":{"remoteFields":true,"concurrentPresentation":true},"cue":["ONCE"],"payload":[{"duration":12,"$remote":{"slots":"/slots-3.json"}}]}]]></Event>
		</EventStream>
		<EventStream schemeIdUri="urn:mpeg:dash:event:alternativeMPD:replace:2025" timescale="1000">
			<Event id="9" presentationTime="90000" duration="10000"><ReplacePresentation uri="/cre/manifest.mpd" maxDuration="10000" clip="false" executeOnce="true"/></Event>
		</EventStream>

		<AdaptationSet id="0" contentType="video" startWithSAP="1" segmentAlignment="true" bitstreamSwitching="true" frameRate="25/1" maxWidth="320" maxHeight="180" par="16:9">
			<Representation id="0" mimeType="video/mp4" codecs="avc1.64000c" bandwidth="247845" width="320" height="180" sar="1:1">
				<SegmentTemplate timescale="1000000" duration="2000000" initialization="init-$RepresentationID$.m4s" media="seg-$RepresentationID$-$Number$.m4s" startNumber="1">
				</SegmentTemplate>
			</Representation>
		</AdaptationSet>
	</Period>
</MPD>
